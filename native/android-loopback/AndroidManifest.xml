<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="org.cleverdomain.data2g.lab">
    <uses-sdk android:minSdkVersion="29" android:targetSdkVersion="35" />
    <application android:label="Data2G Lab" android:theme="@android:style/Theme.Material.Light.NoActionBar"
        android:debuggable="true" android:allowBackup="false" android:hasCode="true">
        <activity android:name=".MainActivity" android:exported="true"
            android:configChanges="orientation|screenSize|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/json" />
            </intent-filter>
        </activity>
    </application>
</manifest>
